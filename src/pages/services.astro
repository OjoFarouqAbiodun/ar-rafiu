---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ServiceList from '../components/ServiceList.astro';
import ContactCtaSection from '../components/home/ContactCtaSection.astro';
---

<BaseLayout
  title="IT services & maintenance"
  description="Installation, maintenance, repair and support for IT, networking, solar and power equipment, from CCTV and solar to UPS, AVR, web design and software."
>
  <PageHeader
    eyebrow="What we do"
    title="Services"
    intro="Installation, maintenance, repair and support for the equipment Ar-Rafiu supplies, and for equipment already in use, from networking and web design through to CCTV, solar and power backup. If you are unsure which service applies, describe the equipment and what it is doing, or not doing."
  />

  <section class="page-section" aria-label="Service list">
    <div class="container">
      <ServiceList headingLevel={2} />
    </div>
  </section>

  <ContactCtaSection />
</BaseLayout>
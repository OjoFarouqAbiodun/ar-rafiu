---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ServiceList from '../components/ServiceList.astro';
import ContactCtaSection from '../components/home/ContactCtaSection.astro';
---

<BaseLayout
  title="Installation, repairs & support"
  description="Installation, maintenance, repair and replacement for IT equipment, plus CCTV, biometric, server, software and power backup work."
>
  <PageHeader
    eyebrow="What we do"
    title="Services"
    intro="Installation, maintenance, repair and replacement for the equipment Ar-Rafiu supplies, and for equipment already in use. If you are unsure which service applies, describe the equipment and what it is doing, or not doing."
  />

  <section class="page-section" aria-label="Service list">
    <div class="container">
      <ServiceList headingLevel={2} />
    </div>
  </section>

  <ContactCtaSection />
</BaseLayout>
---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactCtaSection from '../components/home/ContactCtaSection.astro';
import { companySummary } from '../data/company';
---

<BaseLayout
  title="About"
  description="About Ar-Rafiu Integrated Services Limited: the equipment categories it supplies and the installation, maintenance, repair and replacement services it provides."
>
  <PageHeader title="About Ar-Rafiu" intro={companySummary} />

  <section class="page-section" aria-label="About Ar-Rafiu">
    <div class="container">
      <div class="prose">
        <p>
          Equipment does not have to be new or have been supplied by Ar-Rafiu.
          Installation, maintenance, repair and replacement are available for
          equipment already in service.
        </p>

        <p>
          A single enquiry can cover a purchase, an installation, a repair or
          maintenance. Enquiries are sent on WhatsApp with the area of interest
          already filled in, so the conversation stays in one place.
        </p>
      </div>
    </div>
  </section>

  <ContactCtaSection />
</BaseLayout>
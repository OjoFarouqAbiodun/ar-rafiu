---
import BaseLayout from '../layouts/BaseLayout.astro';
import IntroSection from '../components/home/IntroSection.astro';
import EquipmentSection from '../components/home/EquipmentSection.astro';
import ServicesSection from '../components/home/ServicesSection.astro';
import EnquiryProcessSection from '../components/home/EnquiryProcessSection.astro';
import ContactCtaSection from '../components/home/ContactCtaSection.astro';

/**
 * Homepage section order follows the questions in PRD section 16: who the
 * company is, what it supplies, what it does, how an enquiry works, and where to
 * start one. A "why choose us" block is deliberately absent because PRD section
 * 9.5 forbids inventing history, statistics, certifications or clients, and there
 * is no confirmed company information to put in one.
 */

const description =
  'Ar-Rafiu Integrated Services Limited supplies IT, networking, solar and power equipment, and provides installation, maintenance, repair and support.';
---

<BaseLayout title="IT equipment, solar & support" description={description}>
  <IntroSection />
  <EquipmentSection />
  <ServicesSection />
  <EnquiryProcessSection />
  <ContactCtaSection />
</BaseLayout>
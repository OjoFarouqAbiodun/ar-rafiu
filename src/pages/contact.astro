---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import ContactCtaSection from '../components/home/ContactCtaSection.astro';
import { buildEnquiryMessage, buildWhatsAppChatLink, buildWhatsAppLink } from '../lib/whatsapp';
import { company } from '../data/company';

const whatsappHref = buildWhatsAppLink(buildEnquiryMessage());
const chatHref = buildWhatsAppChatLink();
---

<BaseLayout
  title="Contact"
  description="Contact Ar-Rafiu Integrated Services Limited on WhatsApp, phone or email, with the address in Odongunyan, Ikorodu and business hours of 8am to 4pm."
>
  <PageHeader
    eyebrow="Enquiries"
    title="Contact Ar-Rafiu"
    intro="WhatsApp is the primary enquiry route. Phone, email, address, business hours and the area covered are listed below."
  />

  <EnquiryForm fallbackHref={whatsappHref} />

  <section class="page-section page-section--subtle" aria-label="Contact details">
    <div class="container">
      <h2 class="page-section__title">Contact details</h2>
      <dl class="details">
        <div class="details__row">
          <dt class="details__label">WhatsApp</dt>
          <dd class="details__value">
            <a href={chatHref} target="_blank" rel="noopener noreferrer">
              {company.contact.whatsappDisplay}
              <span class="visually-hidden">(opens WhatsApp)</span>
            </a>
          </dd>
        </div>

        <div class="details__row">
          <dt class="details__label">Phone</dt>
          <dd class="details__value">
            <a href={`tel:${company.contact.phone}`}>{company.contact.phoneDisplay}</a>
          </dd>
        </div>

        <div class="details__row">
          <dt class="details__label">Email</dt>
          <dd class="details__value">
            <a href={`mailto:${company.contact.email}`}>{company.contact.email}</a>
          </dd>
        </div>

        <div class="details__row">
          <dt class="details__label">Address</dt>
          <dd class="details__value">
            <span>{company.contact.address}</span>
          </dd>
        </div>

        <div class="details__row">
          <dt class="details__label">Business hours</dt>
          <dd class="details__value">
            <span>{company.contact.businessHours}</span>
          </dd>
        </div>

        <div class="details__row">
          <dt class="details__label">Service area</dt>
          <dd class="details__value">
            <span>{company.contact.serviceArea}</span>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <ContactCtaSection
    title="Message Ar-Rafiu directly"
    text="Skip the form and open a chat on WhatsApp. Existing equipment is fine to ask about, whether or not it was supplied by Ar-Rafiu, and the reply comes back on WhatsApp."
  />
</BaseLayout>

<style>
  .details {
    max-width: 44rem;
    border-block-start: 1px solid var(--color-border);
  }

  .details__row {
    display: grid;
    gap: var(--space-3xs) var(--space-md);
    padding-block: var(--space-sm);
    border-block-end: 1px solid var(--color-border);
  }

  .details__label {
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .details__value {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
  }

  .details__value a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    font-size: var(--step-1);
    font-weight: var(--weight-medium);
  }

  @media (min-width: 40rem) {
    .details__row {
      grid-template-columns: 10rem 1fr;
      align-items: baseline;
    }
  }
</style>
---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import EquipmentCatalogue from '../components/EquipmentCatalogue.astro';
import ContactCtaSection from '../components/home/ContactCtaSection.astro';
---

<BaseLayout
  title="Equipment and software"
  description="Servers, server racks, computers, printers, photocopiers, CCTV systems, biometric machines, inverters and batteries supplied by Ar-Rafiu Integrated Services Limited."
>
  <PageHeader
    eyebrow="Catalogue"
    title="Equipment and software"
    intro="The equipment categories Ar-Rafiu supplies. If you are not sure which one you need, choose the closest match and say so in your enquiry. Specification and availability for any item are confirmed on enquiry."
  />

  <section class="page-section page-section--subtle" aria-label="Product catalogue">
    <div class="container">
      <EquipmentCatalogue headingLevel={2} />
    </div>
  </section>

  <ContactCtaSection />
</BaseLayout>
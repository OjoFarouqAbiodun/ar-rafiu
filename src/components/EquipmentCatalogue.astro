---
import { equipmentGroups } from '../data/equipment';

/**
 * The equipment catalogue, shared by the homepage section and the products page.
 *
 * Rendered as a description list rather than cards: ten product lines as ten
 * boxes becomes an undifferentiated wall, whereas term/description pairs
 * stay readable as a reference. Category names and one-line purposes are the
 * only claims made, since no specifications have been supplied (PRD section 24).
 *
 * Each term links to its detail page (PRD section 9.4). The link lives on the
 * term rather than on a trailing "read more", because the term is what a visitor
 * is scanning for and a repeated action label would add noise without adding a
 * destination.
 */
interface Props {
  /**
   * Heading level for the group titles. The homepage places the catalogue under
   * its own section heading, so groups sit at `h3`; the products page has no
   * wrapper heading of its own, so they sit at `h2` there. Keeping this explicit
   * is what allows the redundant page-level label heading to be removed without
   * leaving a skipped level (FRONTEND-CORE-RULES section 8).
   */
  headingLevel?: 2 | 3;
}

const { headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';

/**
 * Groups with no categories are dropped rather than rendered.
 *
 * A group is only a heading and a description wrapped around its categories, so
 * an empty one would contribute a title with nothing under it and an empty
 * definition list. Filtering before mapping also keeps the first rendered group
 * as `:first-child`, which is what removes its top rule and padding.
 */
const populatedGroups = equipmentGroups.filter((group) => group.categories.length > 0);
---

<div class="catalogue">
  {
    populatedGroups.map((group) => (
      <section class="group" aria-labelledby={`group-${group.id}`}>
        <Heading class="group__title" id={`group-${group.id}`}>
          {group.title}
        </Heading>
        <p class="group__description">{group.description}</p>
        <dl class="group__categories">
          {group.categories.map((category) => (
            <div class="category">
              <dt>
                <a class="category__link" href={`/products/${category.id}`}>{category.name}</a>
              </dt>
              <dd class="category__detail">{category.description}</dd>
            </div>
          ))}
        </dl>
      </section>
    ))
  }
</div>

<style>
  .group {
    padding-block: var(--space-lg);
    border-block-start: 1px solid var(--color-border);
  }

  .group:first-child {
    padding-block-start: 0;
    border-block-start: 0;
  }

  .group__title {
    font-size: var(--step-2);
    letter-spacing: -0.015em;
  }

  .group__description {
    margin-block-start: var(--space-2xs);
    max-width: var(--measure);
    color: var(--color-text-muted);
    font-size: var(--step-0);
  }

  .group__categories {
    display: grid;
    gap: var(--space-sm);
    margin-block-start: var(--space-md);
  }

  .category {
    display: grid;
    gap: var(--space-3xs);
  }

  .category__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    color: var(--color-primary);
    font-weight: var(--weight-semibold);
    /* The underline colour carries the affordance instead of the text colour, so
       a ten-item reference list stays readable while still reading as links.
       Same treatment as the footer links. */
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 0.2em;
    transition-property: color, text-decoration-color;
    transition-duration: var(--duration-fast);
    transition-timing-function: var(--ease-standard);
  }

  .category__link:hover {
    color: var(--color-primary-hover);
    text-decoration-color: currentColor;
  }

  .category__detail {
    max-width: 56ch;
    color: var(--color-text-muted);
    font-size: var(--step-0);
  }

  @media (min-width: 48rem) {
    .group__categories {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-lg);
    }
  }
</style>
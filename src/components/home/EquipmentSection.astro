---
import EquipmentCatalogue from '../EquipmentCatalogue.astro';

import ActionLink from '../ActionLink.astro';

/**
 * Homepage equipment section.
 *
 * Asymmetric rather than a symmetrical two-column block: the aside carries the
 * heading and the imagery anchor, while the catalogue takes the wider measure it
 * needs for two-column category rows.
 */
---

<section class="equipment" id="equipment" aria-labelledby="equipment-title">
  <div class="container equipment__inner">
    <div class="equipment__aside">
      <p class="equipment__eyebrow">What we supply</p>
      <h2 class="equipment__title" id="equipment-title">Equipment, grouped by use</h2>
      <p class="equipment__text">
        The product lines below are the areas Ar-Rafiu supplies.
      </p>

      <div class="equipment__media">
        <img
          class="equipment__image"
          src="/assets/images/homepage-server-it-equipment.jpg"
          alt="Server and IT equipment"
          loading="lazy"
          decoding="async"
        />
      </div>

      <p class="equipment__actions">
        <ActionLink href="/products" variant="secondary">Browse all products</ActionLink>
      </p>
    </div>

    <EquipmentCatalogue />
  </div>
</section>

<style>
  .equipment {
    padding-block: var(--space-3xl);
    background-color: var(--color-surface-subtle);
    border-block-end: 1px solid var(--color-border);
  }

  .equipment__inner {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
  }

  .equipment__eyebrow {
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }

  .equipment__title {
    margin-block-start: var(--space-2xs);
    font-size: var(--step-4);
  }

  .equipment__text {
    margin-block-start: var(--space-sm);
    max-width: var(--measure);
    color: var(--color-text-muted);
  }

  .equipment__media {
    margin-block-start: var(--space-lg);
    max-width: 22rem;
  }

  .equipment__image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-muted);
  }

  .equipment__actions {
    margin-block-start: var(--space-md);
  }

  @media (min-width: 64rem) {
    .equipment__inner {
      grid-template-columns: 0.85fr 1.35fr;
      gap: var(--space-2xl);
    }
  }
</style>
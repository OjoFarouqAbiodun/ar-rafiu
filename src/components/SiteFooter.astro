---
import { buildWhatsAppChatLink } from '../lib/whatsapp';
import { primaryNavigation, isCurrentPath } from '../data/navigation';
import { company, companySummary } from '../data/company';

/**
 * Site footer.
 *
 * The surface stays light for the same reason as the header: the supplied logo
 * artwork is navy, so it cannot sit on a dark background.
 */

const currentPath = Astro.url.pathname;
const year = new Date().getFullYear();
const chatHref = buildWhatsAppChatLink();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <img
        src="/assets/brand/logo.svg"
        alt={company.legalName}
        width="1412"
        height="256"
      />
      <p class="site-footer__summary">{companySummary}</p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <h2 class="site-footer__heading">Sections</h2>
      <ul class="site-footer__list">
        {
          primaryNavigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={
                  isCurrentPath(item.href, currentPath) ? 'page' : undefined
                }
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-footer__contact">
      <h2 class="site-footer__heading">Contact</h2>
      <ul class="site-footer__list">
        <li>
          <a href={chatHref} target="_blank" rel="noopener noreferrer">
            {company.contact.whatsappDisplay}
            <span class="visually-hidden">(opens WhatsApp)</span>
          </a>
        </li>
        <li>
          <a href={`tel:${company.contact.phone}`}>{company.contact.phoneDisplay}</a>
        </li>
        <li>
          <a href={`mailto:${company.contact.email}`}>{company.contact.email}</a>
        </li>
        <li>
          <span>{company.contact.address}</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__legal">
    <p>&copy; {year} {company.legalName}</p>
    <p class="site-footer__credit">
      Made with <span aria-hidden="true">❤️</span> by
      <a
        href="https://linkedin.com/in/ojo-farouq-abiodun/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Ojo Farouq
        <span class="visually-hidden">(opens in a new tab)</span>
      </a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: auto;
    padding-block: var(--space-2xl) var(--space-lg);
    background-color: var(--color-surface-subtle);
    border-top: 2px solid var(--color-primary);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
  }

  .site-footer__brand img {
    width: auto;
    height: 2rem;
  }

  .site-footer__summary {
    max-width: 34ch;
    margin-block-start: var(--space-sm);
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  .site-footer__heading {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .site-footer__list {
    display: grid;
    gap: var(--space-2xs);
    margin-block-start: var(--space-sm);
    font-size: var(--step-0);
  }

  .site-footer__list a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    color: var(--color-text);
    text-decoration-color: var(--color-border-strong);
  }

  .site-footer__list a:hover {
    color: var(--color-primary);
    text-decoration-color: currentColor;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    /* Centre the items against each other rather than stretching them, so the
       copyright and the credit share a baseline when they end up on one line.
       Wrapping is kept, so a narrow viewport still stacks them. */
    align-items: center;
    gap: var(--space-2xs) var(--space-md);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-md);
    border-top: 1px solid var(--color-border);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  /* Left-aligned on mobile: the credit simply follows the copyright. An auto
     margin is deliberately not applied here, because on a wrapped line by
     itself it would absorb all the free space and push the credit to the right
     edge, reading as a centred item. */
  .site-footer__credit {
    white-space: nowrap;
  }

  /* Tablet and up: pushed to the far edge so the credit sits opposite the
     copyright. */
  @media (min-width: 48rem) {
    .site-footer__credit {
      margin-inline-start: auto;
    }
  }

  /* Muted like the rest of the legal row rather than picking up the primary
     link colour, so the credit stays a quiet detail. The name is underlined by
     neither state: an underline under a personal credit reads as a link to the
     site rather than to a profile, so the pointer cursor carries the affordance
     instead. */
  .site-footer__credit a {
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .site-footer__credit a:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  @media (min-width: 48rem) {
    .site-footer__inner {
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: var(--space-xl);
    }
  }
</style>
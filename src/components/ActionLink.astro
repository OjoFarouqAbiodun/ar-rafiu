---
/**
 * The single interactive control used across the site.
 *
 * FRONTEND-CORE-RULES section 10 requires distinct action hierarchy rather than
 * one button treatment everywhere, so variants map to roles: `primary` for the
 * main action on a light surface, `accent` for a filled red control, `secondary`
 * for a supporting action, and `quiet` for tertiary links that should not
 * compete with a button.
 *
 * The shared treatment lives in `base.css` rather than in a scoped block, so a
 * form's `<button>` carries the same appearance as this link.
 */

type ActionVariant = 'primary' | 'accent' | 'secondary' | 'quiet';

interface Props {
  href: string;
  variant?: ActionVariant;
  /** Opens in a new tab with `rel="noopener"`. Use for links that leave the site. */
  external?: boolean;
  /** Screen-reader suffix announced when the link opens elsewhere. */
  externalLabel?: string;
  class?: string;
}

const {
  href,
  variant = 'primary',
  external = false,
  externalLabel = '(opens in a new tab)',
  class: className,
} = Astro.props;
---

<a
  class:list={['action', `action--${variant}`, className]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <slot />
  {external && <span class="visually-hidden"> {externalLabel}</span>}
</a>

---
import { services } from '../data/services';

/**
 * The service list, shared by the homepage section and the services page.
 *
 * Numbered rather than carded, because a long list of services as boxes is the
 * repetitive grid FRONTEND-CORE-RULES section 6 warns against, and because the
 * services read as a set of separate things the company does rather than as tiers.
 *
 * Each name links to its detail page (PRD section 9.3), so the numbering stays
 * decorative and the name stays the target.
 */

interface Props {
  /**
   * Heading level for the service names. The homepage places the list under its
   * own section heading, so names sit at `h3`; the services page has no wrapper
   * heading of its own, so they sit at `h2` there. Keeping this explicit is what
   * allows the redundant page-level label heading to be removed without leaving a
   * skipped level (FRONTEND-CORE-RULES section 8).
   */
  headingLevel?: 2 | 3;
}

const { headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';

const formatted = services.map((service, index) => ({
  ...service,
  number: String(index + 1).padStart(2, '0'),
}));
---

<ol class="service-list">
  {
    formatted.map((service) => (
      <li class="service">
        <span class="service__number" aria-hidden="true">
          {service.number}
        </span>
        <div class="service__body">
          <Heading class="service__name">
            <a class="service__link" href={`/services/${service.id}`}>{service.name}</a>
          </Heading>
          <p class="service__description">{service.description}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .service-list {
    display: grid;
    gap: 0;
    border-block-start: 1px solid var(--color-border);
  }

  .service {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-sm);
    padding-block: var(--space-md);
    border-block-end: 1px solid var(--color-border);
  }

  /* `--color-accent` measures 4.09:1 on white, which is below AA for text at
     this size, so the numbers use `--color-accent-strong` (6.43:1) instead.
     Size and weight are unchanged, so the numeral stays subordinate to the
     service name beside it. */
  .service__number {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    color: var(--color-accent-strong);
    font-variant-numeric: tabular-nums;
  }

  .service__name {
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }

  /* Heading colour is left to the shared `h1, h2, h3, h4` rule; only the link
     affordance and its states belong here. */
  .service__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 0.2em;
    transition-property: color, text-decoration-color;
    transition-duration: var(--duration-fast);
    transition-timing-function: var(--ease-standard);
  }

  .service__link:hover {
    color: var(--color-primary-hover);
    text-decoration-color: currentColor;
  }

  .service__description {
    margin-block-start: var(--space-3xs);
    max-width: 52ch;
    color: var(--color-text-muted);
    font-size: var(--step-0);
  }

  @media (min-width: 64rem) {
    .service-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-2xl);
    }
  }
</style>
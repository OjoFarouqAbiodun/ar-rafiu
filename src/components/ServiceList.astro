---
import { services } from '../data/services';

/**
 * The service list, shared by the homepage section and the services page.
 *
 * Numbered rather than carded, because eleven services as eleven boxes is the
 * repetitive grid FRONTEND-CORE-RULES section 6 warns against, and because the
 * services read as a set of separate things the company does rather than as tiers.
 */

const formatted = services.map((service, index) => ({
  ...service,
  number: String(index + 1).padStart(2, '0'),
}));
---

<ol class="service-list">
  {
    formatted.map((service) => (
      <li class="service">
        <span class="service__number" aria-hidden="true">
          {service.number}
        </span>
        <div class="service__body">
          <h3 class="service__name">{service.name}</h3>
          <p class="service__description">{service.description}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .service-list {
    display: grid;
    gap: 0;
    border-block-start: 1px solid var(--color-border);
  }

  .service {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-sm);
    padding-block: var(--space-md);
    border-block-end: 1px solid var(--color-border);
  }

  .service__number {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .service__name {
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }

  .service__description {
    margin-block-start: var(--space-3xs);
    max-width: 52ch;
    color: var(--color-text-muted);
    font-size: var(--step-0);
  }

  @media (min-width: 64rem) {
    .service-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-2xl);
    }
  }
</style>
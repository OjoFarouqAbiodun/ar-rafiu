---
import EnquiryLink from './EnquiryLink.astro';
import { primaryNavigation, isCurrentPath } from '../data/navigation';
import { company } from '../data/company';

/**
 * Sticky site header.
 *
 * The surface stays near-white rather than navy because the supplied logo
 * artwork is navy and red; a navy header would render its navy elements
 * invisible. That constraint drives the header treatment.
 */

const currentPath = Astro.url.pathname;
---

<header class="site-header" data-site-header data-nav-ready="false">
  <div class="site-header__inner container">
    <a class="site-header__brand" href="/">
      <img
        src="/assets/brand/logo.svg"
        alt={company.legalName}
        width="1412"
        height="256"
      />
    </a>

    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
    >
      <span class="visually-hidden">Menu</span>
      <svg
        class="site-header__icon site-header__icon--open"
        viewBox="0 0 24 24"
        width="32"
        height="32"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M3 6h18"></path>
        <path d="M6 12h12"></path>
        <path d="M3 18h18"></path>
      </svg>
      <svg
        class="site-header__icon site-header__icon--close"
        viewBox="0 0 24 24"
        width="32"
        height="32"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4.5 4.5l15 15"></path>
        <path d="M19.5 4.5l-15 15"></path>
      </svg>
    </button>

    <nav class="site-nav" id="primary-navigation" aria-label="Primary">
      <ul class="site-nav__list">
        {
          primaryNavigation.map((item) => (
            <li>
              <a
                class="site-nav__link"
                href={item.href}
                aria-current={isCurrentPath(item.href, currentPath) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="site-nav__enquiry">
        <EnquiryLink variant="primary">
          Enquire on WhatsApp
        </EnquiryLink>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    min-height: 4.5rem;
  }

  .site-header__brand {
    display: block;
    margin-inline-end: auto;
    padding-block: var(--space-2xs);
  }

  .site-header__brand img {
    /* Height-driven so the 5.52:1 artwork keeps its proportions at any
       header size without a separate width rule. */
    width: auto;
    height: 1.75rem;
  }

  /* Hidden until the script marks the header ready. Without JavaScript the
     navigation stays expanded, so a toggle that cannot work should not be
     shown.

     The control is drawn as a bare glyph: no border, fill or background box,
     so it reads as an icon rather than a button-shaped square. The 3rem
     hit area (`--touch-target`, 48px) is kept by the box model rather than by
     a visible frame, so removing the frame costs nothing for touch or
     keyboard users. */
  .site-header__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: var(--touch-target);
    height: var(--touch-target);
    padding: 0;
    background-color: transparent;
    border: 0;
    border-radius: 0;
    color: var(--color-primary);
  }

  .site-header__icon--close,
  .site-header__toggle[aria-expanded='true'] .site-header__icon--open {
    display: none;
  }

  .site-header__toggle[aria-expanded='true'] .site-header__icon--close {
    display: block;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin: 0;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    padding-inline: var(--space-2xs);
    color: var(--color-text-muted);
    font-weight: var(--weight-medium);
    text-decoration: none;
    transition-property: color;
    transition-duration: var(--duration-fast);
    transition-timing-function: var(--ease-standard);
  }

  .site-nav__link:hover {
    color: var(--color-primary);
  }

  /* The current page is marked with weight and colour together rather than
     colour alone. */
  .site-nav__link[aria-current='page'] {
    color: var(--color-primary);
    font-weight: var(--weight-semibold);
    box-shadow: inset 0 -2px 0 var(--color-accent);
  }

  /* Below the navigation breakpoint the panel is collapsed, but only once the
     script has marked the header as ready. Without JavaScript the list stays
     visible and stacked, so navigation never depends on scripting.

     The breakpoint is `--bp-lg` (64rem). PRD section 19 puts tablet at 768px
     and desktop at 1024px, and the collapsed panel is the tablet
     presentation, so the full navigation starts at the desktop tier rather
     than at 768px. `site.ts` queries the same value so the script and these
     rules cannot disagree. */
  @media (max-width: 63.9375rem) {
    .site-header__inner {
      padding-block: var(--space-2xs);
    }

    [data-nav-ready='true'] .site-header__toggle {
      display: inline-flex;
    }

    /* The panel is a floating surface anchored to the bottom edge of the sticky
       header rather than a wrapped flex row, so opening the menu overlays the
       page instead of pushing the page heading down. It is inset by the same
       gutter the shared container uses, so its edges line up with the content
       above it. */
    [data-nav-ready='true'] .site-nav {
      position: absolute;
      inset-inline: var(--gutter);
      top: 100%;
      z-index: var(--z-raised);
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-sm);
      margin-block-start: var(--space-2xs);
      padding-block: var(--space-sm) var(--space-md);
      padding-inline: var(--space-2xs);
      background-color: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-lg);
      /* `visibility` rather than `display` so the panel can fade, and so its
         links also leave the tab order while it is closed. `allow-discrete`
         holds the panel visible for the length of the fade-out. Reduced motion
         is already neutralised for every element in `base.css`. */
      visibility: hidden;
      opacity: 0;
      transform: translateY(-0.5rem);
      pointer-events: none;
      transition-property: opacity, transform, visibility;
      transition-duration: var(--duration-base);
      transition-timing-function: var(--ease-standard);
      transition-behavior: allow-discrete;
    }

    [data-nav-ready='true'] .site-nav[data-open='true'] {
      visibility: visible;
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    [data-nav-ready='true'] .site-nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    [data-nav-ready='true'] .site-nav__link {
      padding: var(--space-sm);
      border-bottom: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
    }

    [data-nav-ready='true'] .site-nav__list li:last-child .site-nav__link {
      border-bottom: 0;
    }

    [data-nav-ready='true'] .site-nav__link:hover {
      background-color: var(--color-surface-subtle);
    }

    [data-nav-ready='true'] .site-nav__link[aria-current='page'] {
      box-shadow: none;
    }
  }

  @media (min-width: 64rem) {
    .site-header__inner {
      min-height: 5rem;
    }

    .site-header__brand img {
      height: 2rem;
    }
  }
</style>